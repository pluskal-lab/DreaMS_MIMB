events.out.tfevents.* # TensorBoard event files
.tensorboard-info/
mlruns/               # MLflow
mlartifacts/
ray_results/          # Ray Tune
tune_results/
dask-worker-space/


# Scheduler/cluster job output files (e.g., SLURM)
slurm-*.out
slurm-*.err
*.o[0-9]*
*.e[0-9]*
*.po[0-9]*
*.pe[0-9]*

# Keys and certificates (avoid committing secrets)
*.key
*.pem
*.cert
*.crt

