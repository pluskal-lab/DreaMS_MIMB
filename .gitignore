# NEW ML IGNORES
##############################

# General-purpose ML / Python .gitignore
#  Safe defaults for experiments, logs, checkpoints, environments, IDE settings, and OS files.

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Build and packaging artifacts created by setuptools/pip/build tools
build/
dist/
.eggs/
*.egg-info/
*.egg
pip-wheel-metadata/
wheelhouse/
.venv-build/

# Test tooling caches and coverage outputs
.pytest_cache/
.coverage
.coverage.*
.cache/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/
.pyre/
.dmypy.json
.pytype/

# Local virtual environments and environment files (keep these out of VCS)
.env
.env.*
*.env
venv/
.venv/
env/
.envs/
.conda/
conda-env/
.mamba/
.mambaforge/
.poetry/
.poetry-cache/

# Jupyter Notebook transient files and checkpoints
.ipynb_checkpoints/
**/*-checkpoint.ipynb
.jupyter/

# Logs commonly produced by apps, training runs, and scripts
logs/
**/*.log
*.log
*.out
*.err

# Outputs, results, and temporary scratch/caches created during experiments
output/
outputs/
results/
artifacts/
artifacts_tmp/
scratch/
tmp/
temp/
tmp_*/
**/.tmp/
**/.cache/
.cache/

# Checkpoints and model weights from training
*.ckpt
*.pt
*.pth
*.onnx
*.h5
*.joblib
*.pkl
*.safetensors
checkpoints/
models/
lightning_logs/

# Popular experiment tracking/visualization tool directories
wandb/
