# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Abstra
# Abstra is an AI-powered process automation framework.
# Ignore directories containing user credentials, local state, and settings.
# Learn more at https://abstra.io/docs
.abstra/

# Visual Studio Code
#  Visual Studio Code specific template is maintained in a separate VisualStudioCode.gitignore 
#  that can be found at https://github.com/github/gitignore/blob/main/Global/VisualStudioCode.gitignore
#  and can be added to the global gitignore or merged into this file. However, if you prefer, 
#  you could uncomment the following to ignore the enitre vscode folder
# .vscode/

# Ruff stuff:
.ruff_cache/

# PyPI configuration file
.pypirc

# Cursor
#  Cursor is an AI-powered code editor. `.cursorignore` specifies files/directories to
#  exclude from AI features like autocomplete and code analysis. Recommended for sensitive data
#  refer to https://docs.cursor.com/context/ignore-files
.cursorignore
.cursorindexingignore

.DS_Store
.idea/


# ignore everything under the repository-root /data/ directory
/data/**

# but do NOT ignore these three files
!/data/Piper_data_smiles.csv
!/data/Piper_sirius_all_annotated.mgf
!/data/Piper_sirius_matched_annotated.mgf

lightning_logs/
*.ckpt
results/
output/
outputs/
wandb/
scripts/wandb/
scripts/outputs/
configs/
misc/
notebooks/misc


# Ignore all notebooks in the folder...
notebooks/*.ipynb
# ...then un-ignore the five we want to publish
!notebooks/0_notebook_tutorial.ipynb
!notebooks/1_data_preparation.ipynb
!notebooks/2_deduplication.ipynb
!notebooks/3_library_matching.ipynb
!notebooks/4_molecular_networking.ipynb

# Logs, checkpoints, and other local artifacts
notebooks/lightning_logs/
notebooks/*.ckpt
*.ckpt
*.log
.DS_Store


# Ignore everything in scripts/
scripts/*

# Allow three files
!scripts/download_assets.py
!scripts/download_gems.py
!scripts/install_env.sh
!scripts/install_env_win.bat

# Ignore run artifacts
scripts/outputs/
scripts/wandb/
scripts/**/*.log

# benchmark
benchmark/*

# Keep the package root files
!benchmark/__init__.py
!benchmark/definitions.py

# Keep only these in utils/
!benchmark/utils/
benchmark/utils/*
!benchmark/utils/__init__.py
!benchmark/utils/chem.py
!benchmark/utils/data.py
!benchmark/utils/plots.py

# Ignore caches/artefacts
**/__pycache__/
*.pyc


